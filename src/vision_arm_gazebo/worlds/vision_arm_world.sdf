<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="vision_arm_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- No workbench model here: it is a link in vision_arm.urdf.xacro, welded
         to the world alongside base_link, so Gazebo and MoveIt share one
         definition of the surface the arm is bolted to. Top at z=0.75. -->

    <!-- Three 5 cm cubes in a row on the workbench top (z = 0.75 + 0.025).
         Deliberately an easy scene: side by side, 12 cm apart, all at the same
         y, so one camera pose frames all three and the arm never has to sweep
         to find them. A real cell would be laid out this way too - you position
         the robot so the parts land in its sweet spot. Add clutter later.
         5 cm fits the MSG gripper's 10.4 cm maximum opening with 2.7 cm of
         margin per jaw, leaves 7 cm of clear air between neighbours, and is
         several hundred pixels at grasp range (the old 3 cm ones were ~120).
         The row sits at radius 0.44 m, inside the reachable top-down patch from
         tools/reach_map.py, and 10 cm clear of the base plate, which reaches
         out to y=-0.30. -->
    <model name="cube_red">
      <pose>-0.12 -0.425 0.775 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.09</mass><inertia><ixx>3.75e-5</ixx><iyy>3.75e-5</iyy><izz>3.75e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cube_green">
      <pose>0.0 -0.425 0.775 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.09</mass><inertia><ixx>3.75e-5</ixx><iyy>3.75e-5</iyy><izz>3.75e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.9 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cube_blue">
      <pose>0.12 -0.425 0.775 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.09</mass><inertia><ixx>3.75e-5</ixx><iyy>3.75e-5</iyy><izz>3.75e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
